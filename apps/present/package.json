{
  "name": "@tcw/present",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "next start --port 3003",
    "lint": "eslint",
    "preflight:health": "node scripts/health-preflight.mjs",
    "preflight:entra": "node scripts/entra-preflight.mjs",
    "verify:production-evidence": "node scripts/production-evidence.mjs",
    "smoke:local": "node scripts/local-smoke.mjs",
    "smoke:local:five-viewers": "PRESENT_SMOKE_VIEWERS=5 PRESENT_SMOKE_FAKE_SCREEN=1 node scripts/local-smoke.mjs",
    "smoke:local:fake-screen": "PRESENT_SMOKE_FAKE_SCREEN=1 node scripts/local-smoke.mjs",
    "smoke:local:handout": "PRESENT_SMOKE_HANDOUT=1 node scripts/local-smoke.mjs",
    "smoke:local:headed": "PRESENT_SMOKE_HEADLESS=0 node scripts/local-smoke.mjs",
    "smoke:local:native-picker": "PRESENT_SMOKE_HEADLESS=0 PRESENT_SMOKE_NATIVE_PICKER=1 node scripts/local-smoke.mjs",
    "smoke:local:refresh": "PRESENT_SMOKE_REFRESH=1 PRESENT_SMOKE_FAKE_SCREEN=1 node scripts/local-smoke.mjs",
    "smoke:local:secret-check": "PRESENT_SMOKE_SECRET_CHECK=1 PRESENT_SMOKE_FAKE_SCREEN=1 node scripts/local-smoke.mjs",
    "smoke:production:interactive": "PRESENT_SMOKE_BASE_URL=https://present.tc-waiblingen.de PRESENT_SMOKE_INTERACTIVE_AUTH=1 PRESENT_SMOKE_HEADLESS=0 PRESENT_SMOKE_VIEWERS=5 PRESENT_SMOKE_SECRET_CHECK=1 PRESENT_SMOKE_REFRESH=1 PRESENT_SMOKE_FAKE_SCREEN=1 node scripts/local-smoke.mjs",
    "smoke:production:native-picker": "PRESENT_SMOKE_BASE_URL=https://present.tc-waiblingen.de PRESENT_SMOKE_INTERACTIVE_AUTH=1 PRESENT_SMOKE_HEADLESS=0 PRESENT_SMOKE_NATIVE_PICKER=1 PRESENT_SMOKE_SECRET_CHECK=1 node scripts/local-smoke.mjs",
    "smoke:livekit:endpoint": "node scripts/livekit-endpoint-smoke.mjs",
    "test": "mkdir -p .tmp && TMPDIR=$PWD/.tmp vitest run",
    "test:watch": "mkdir -p .tmp && TMPDIR=$PWD/.tmp vitest",
    "test:coverage": "mkdir -p .tmp && TMPDIR=$PWD/.tmp vitest run --coverage"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.24",
    "@node-rs/argon2": "^2.2.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "livekit-client": "^2.22.1",
    "livekit-server-sdk": "^2.18.0",
    "next": "^16.3.4",
    "openid-client": "^6.8.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tcw/config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
