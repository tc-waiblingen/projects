# Public app URL used for QR handouts and redirects.
PRESENT_PUBLIC_URL=http://localhost:3003

# SQLite database path.
PRESENT_DB_PATH=./data/present.db

# 32+ random bytes used to sign moderator and viewer sessions.
# Generate with: openssl rand -hex 32
PRESENT_SESSION_SECRET=

# Local-only moderator shortcut. Ignored in production.
PRESENT_DEV_AUTH=0

# Microsoft Entra app registration.
# Redirect URI must include /api/auth/entra/callback.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_ADMIN_ROLE=Present.Admin
ENTRA_MODERATOR_ROLE=Present.Moderator

# Local development defaults for infra/livekit/local.
# Production uses LIVEKIT_URL=wss://live.tc-waiblingen.de.
# TURN is not configured in the current deployment phase.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
LIVEKIT_ROOM_PREFIX=tcw-present
