{
  "name": "tcw-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:website": "pnpm --filter @tcw/website dev",
    "dev:tv": "pnpm --filter @tcw/tv dev",
    "dev:dispo": "pnpm --filter @tcw/dispo dev",
    "dev:present": "pnpm --filter @tcw/present dev",
    "build": "turbo run build",
    "build:website": "turbo run build --filter @tcw/website",
    "build:tv": "turbo run build --filter @tcw/tv",
    "build:dispo": "turbo run build --filter @tcw/dispo",
    "build:present": "turbo run build --filter @tcw/present",
    "lint": "turbo run lint",
    "lint:dispo": "pnpm --filter @tcw/dispo lint",
    "lint:present": "pnpm --filter @tcw/present lint",
    "preflight:present:entra": "pnpm --filter @tcw/present preflight:entra",
    "verify:present:production-evidence": "pnpm --filter @tcw/present verify:production-evidence",
    "smoke:present:local": "pnpm --filter @tcw/present smoke:local",
    "smoke:present:local:five-viewers": "pnpm --filter @tcw/present smoke:local:five-viewers",
    "smoke:present:local:fake-screen": "pnpm --filter @tcw/present smoke:local:fake-screen",
    "smoke:present:local:handout": "pnpm --filter @tcw/present smoke:local:handout",
    "smoke:present:local:headed": "pnpm --filter @tcw/present smoke:local:headed",
    "smoke:present:local:native-picker": "pnpm --filter @tcw/present smoke:local:native-picker",
    "smoke:present:local:refresh": "pnpm --filter @tcw/present smoke:local:refresh",
    "smoke:present:local:secret-check": "pnpm --filter @tcw/present smoke:local:secret-check",
    "smoke:present:production:interactive": "pnpm --filter @tcw/present smoke:production:interactive",
    "smoke:present:production:native-picker": "pnpm --filter @tcw/present smoke:production:native-picker",
    "smoke:present:livekit:endpoint": "pnpm --filter @tcw/present smoke:livekit:endpoint",
    "test": "turbo run test",
    "test:dispo": "pnpm --filter @tcw/dispo test",
    "test:present": "pnpm --filter @tcw/present test",
    "generate:types": "pnpm -r generate:types"
  },
  "devDependencies": {
    "turbo": "^2.9.14"
  },
  "pnpm": {
    "overrides": {
      "flatted": ">=3.4.2"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
